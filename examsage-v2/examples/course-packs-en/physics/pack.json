          "nature": "derivation",
          "assumptions": [
            "Ideal linear spring in static equilibrium, within its elastic limit"
          ],
          "steps": [
            {
              "text": "The restoring force is Fs=-kx.",
              "refs": [
                {
                  "document_id": "lesson",
                  "page": 2
                }
              ]
