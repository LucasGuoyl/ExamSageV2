      "kind": "proof",
      "title": "Hooke spring in static equilibrium",
      "text": "Combining the restoring force Fs=-kx with the equilibrium condition F+Fs=0 gives x=F/k.",
      "refs": [
        {
          "document_id": "lesson",
          "page": 1
        },
        {
          "document_id": "lesson",
          "page": 2
        }
