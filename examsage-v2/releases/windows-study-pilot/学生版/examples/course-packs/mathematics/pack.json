          "document_id": "lesson",
          "page": 2
        }
      ],
      "details": {
        "academic": {
          "nature": "derivation",
          "assumptions": [
            "n 是正整数"
          ],
          "steps": [
            {
              "text": "n=1 时 S_1=1=1(1+1)/2；假设 S_k=k(k+1)/2。",
              "refs": [
                {
                  "document_id": "lesson",
                  "page": 1
                }
              ]
            },
            {
              "text": "S_(k+1)=k(k+1)/2+(k+1)=(k+1)(k+2)/2。",
              "refs": [
                {
                  "document_id": "lesson",
                  "page": 2
                }
              ]
            }
          ]
        }
      }
    },
